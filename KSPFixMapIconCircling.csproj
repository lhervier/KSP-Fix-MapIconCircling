<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>KSPFixMapIconCircling</AssemblyName>
    <RootNamespace>com.github.lhervier.ksp.fix.mapiconcircling</RootNamespace>
    <Version>0.1.0-dev</Version>
    <Description>Keeps the centre of mass of an unloaded landed vessel at its place after a long floating origin shift, so that its map icon no longer circles around it in time warp</Description>
    <!-- Straight into the folder that gets copied to the GameData of KSP. -->
    <OutputPath>GameData\KSPFixMapIconCircling</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <!-- Read from the KSP install given by KSPDIR, never copied next to the DLL. -->
    <Reference Include="Assembly-CSharp">
      <HintPath>$(KSPDIR)\KSP_x64_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(KSPDIR)\KSP_x64_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(KSPDIR)\KSP_x64_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
